{
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Jwt": {
    "Secret": "",
    "Issuer": "AICodeReviewer",
    "Audience": "AICodeReviewer",
    "ExpiryMinutes": "60",
    "RefreshTokenExpiryDays": "30"
  },
  "Groq": {
    "ApiKey": "",
    "Model": "openai/gpt-oss-120b",
    "MaxTokens": 3000,
    "ReasoningEffort": ""
  },
  "Review": {
    "MaxFilesPerReview": 30,
    "MaxBatchChars": 12000,
    "MaxBatches": 4,
    "MaxRuleChars": 4000,
    "MaxInlineComments": 25,
    "PostToGitHub": true,
    "PostCommitStatus": true
  },
  "Embedding": {
    "Provider": "Gemini",
    "ApiKey": "",
    "Model": "gemini-embedding-001",
    "Dimensions": 768
  },
  "Rag": {
    "Enabled": true,
    "QdrantUrl": "https://YOUR-CLUSTER.cloud.qdrant.io:6333",
    "QdrantApiKey": "",
    "Collection": "code_chunks",
    "MinScore": 0.5
  },

  "AllowedOrigins": {
    "Frontend": "http://localhost:8080",
    "Frontend2": "http://localhost:5173"
  },

  "App": {
    "FrontendUrl": "http://localhost:8080",
    "BackendUrl": ""
  },

  "GitHub": {
    "ClientId": "",
    "ClientSecret": "",
    "ConnectCallbackUri": "",
    "WebhookSecret": ""
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },

  "AllowedHosts": "*"
}